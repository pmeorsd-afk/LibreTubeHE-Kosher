<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_kosher_home_gradient">

    <com.github.libretube.ui.views.CustomSwipeToRefresh
        android:id="@+id/refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            tools:visibility="visible"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="10dp">

                <HorizontalScrollView
                    android:id="@+id/home_category_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layoutDirection="rtl"
                    android:paddingHorizontal="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="4dp"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/home_category_chips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/home_category_compass"
                            style="?materialIconButtonFilledTonalStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/category"
                            android:tooltipText="@string/category"
                            app:icon="@drawable/ic_compass" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/home_chip_all"
                            style="@style/ElevatedFilterChip"
                            android:checked="true"
                            android:text="@string/all" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/home_chip_podcasts"
                            style="@style/ElevatedFilterChip"
                            android:text="@string/category_podcasts" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/home_chip_news"
                            style="@style/ElevatedFilterChip"
                            android:text="@string/category_news" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/home_chip_music"
                            style="@style/ElevatedFilterChip"
                            android:text="@string/category_music" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/home_chip_games"
                            style="@style/ElevatedFilterChip"
                            android:text="@string/category_games" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/home_chip_sports"
                            style="@style/ElevatedFilterChip"
                            android:text="@string/category_sports" />

                    </com.google.android.material.chip.ChipGroup>

                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/featuredTV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?selectableItemBackground"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        style="@style/HomeCategoryTitle"
                        android:text="@string/featured"
                        app:drawableEndCompat="@drawable/ic_arrow_right" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/featuredRV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingHorizontal="6dp"
                    android:visibility="gone"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:spanCount="2"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/watchingTV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?selectableItemBackground"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        style="@style/HomeCategoryTitle"
                        android:text="@string/continue_watching"
                        app:drawableEndCompat="@drawable/ic_arrow_right" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/watchingRV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                <LinearLayout
                    android:id="@+id/trendingTV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?selectableItemBackground"
                    android:paddingEnd="12dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        style="@style/HomeCategoryTitle"
                        android:background="@null"
                        android:text="@string/trending"
                        app:drawableEndCompat="@drawable/ic_arrow_right" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/trending_category"
                        style="?materialIconButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:visibility="gone"
                        app:icon="@drawable/ic_frame"
                        android:tooltipText="@string/category"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/trending_region"
                        style="?materialIconButtonFilledTonalStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="5dp"
                        android:visibility="gone"
                        app:icon="@drawable/ic_region"
                        android:tooltipText="@string/region"/>

                </LinearLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:descendantFocusability="blocksDescendants">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/trendingRV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:visibility="gone"
                        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        app:spanCount="2" />

                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/bookmarksTV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="8dp"
                    android:background="?selectableItemBackground"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        style="@style/HomeCategoryTitle"
                        android:text="@string/bookmarks"
                        app:drawableEndCompat="@drawable/ic_arrow_right" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/bookmarksRV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone"
                    app:layoutManager="com.google.android.material.carousel.CarouselLayoutManager" />

                <LinearLayout
                    android:id="@+id/playlistsTV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="8dp"
                    android:background="?selectableItemBackground"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        style="@style/HomeCategoryTitle"
                        android:text="@string/playlists"
                        app:drawableEndCompat="@drawable/ic_arrow_right" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/playlistsRV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone"
                    app:layoutManager="com.google.android.material.carousel.CarouselLayoutManager" />

            </LinearLayout>

        </ScrollView>

    </com.github.libretube.ui.views.CustomSwipeToRefresh>

    <LinearLayout
        android:id="@+id/starter_home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="rtl"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="150dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/starter_category"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_home_icon_circle"
                android:contentDescription="@string/category"
                android:padding="9dp"
                android:src="@drawable/ic_compass"
                app:tint="@android:color/white" />

            <EditText
                android:id="@+id/starter_search_input"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:autofillHints="search"
                android:background="@drawable/bg_home_search_pill"
                android:hint="@string/home_start_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="18dp"
                android:singleLine="true"
                android:textAlignment="viewStart"
                android:textColor="@android:color/white"
                android:textColorHint="#B3FFFFFF"
                android:textDirection="rtl"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/starter_voice_search"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_home_icon_circle"
                android:contentDescription="@string/home_voice_search"
                android:padding="9dp"
                android:src="@drawable/ic_mic"
                app:tint="@android:color/white" />

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="48dp"
            android:layout_marginTop="46dp"
            app:cardElevation="0dp"
            app:cardCornerRadius="16dp"
            app:strokeWidth="0dp"
            android:backgroundTint="@android:color/transparent">

            <!-- Card Background drawable is bg_glass_card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="26dp">

                <!-- Equalizer container -->
                <LinearLayout
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_glass_equalizer_container"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <!-- Custom Equalizer wave bars -->
                    <View
                        android:layout_width="3.5dp"
                        android:layout_height="18dp"
                        android:layout_marginHorizontal="2.5dp"
                        android:background="@color/kosher_primary" />

                    <View
                        android:layout_width="3.5dp"
                        android:layout_height="28dp"
                        android:layout_marginHorizontal="2.5dp"
                        android:background="@color/kosher_primary" />

                    <View
                        android:layout_width="3.5dp"
                        android:layout_height="22dp"
                        android:layout_marginHorizontal="2.5dp"
                        android:background="@color/kosher_primary" />

                    <View
                        android:layout_width="3.5dp"
                        android:layout_height="25dp"
                        android:layout_marginHorizontal="2.5dp"
                        android:background="@color/kosher_primary" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/home_start_title"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/home_start_subtitle"
                    android:textColor="#B3FFFFFF"
                    android:textSize="14sp" />

                <!-- Green Privacy Pill -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_glass_privacy"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_locked"
                        app:tint="#10B981" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="פרטיות מלאה • ללא מעקב"
                        android:textColor="#10B981"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/category_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:background="#33000000"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/category_panel"
            android:layout_width="320dp"
            android:layout_height="match_parent"
            android:layout_gravity="right|top"
            android:layoutDirection="rtl"
            android:background="@drawable/bg_home_category_panel"
            android:elevation="12dp"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:paddingHorizontal="12dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="12dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="#667C3AED">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:padding="6dp"
                        android:src="@drawable/ic_compass"
                        app:tint="#e9d5ff" />

                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LibreKosher"
                        android:textColor="@android:color/white"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="v31.4 · פרטיות מלאה"
                        android:textColor="#80FFFFFF"
                        android:textSize="10sp" />

                </LinearLayout>

                <ImageButton
                    android:id="@+id/category_close_btn"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_home_icon_circle"
                    android:src="@drawable/ic_close"
                    android:contentDescription="@string/close"
                    app:tint="#80FFFFFF" />

            </LinearLayout>

            <!-- User profile card/pill -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="א"
                    android:textColor="#c4b5fd"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_home_icon_circle" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="אנונימי לחלוטין"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="אין חשבון · פרטיות מקסימלית"
                        android:textColor="#9CFFFFFF"
                        android:textSize="11sp" />

                </LinearLayout>

                <!-- Active green dot -->
                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_home_icon_circle"
                    android:backgroundTint="#34d399" />

            </LinearLayout>

            <!-- Content section label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginBottom="6dp"
                android:text="ערוצי תוכן"
                android:textColor="#80FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Category Music -->
            <LinearLayout
                android:id="@+id/category_music"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="8dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/category_music_icon"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_glass_card"
                    android:padding="8dp"
                    android:src="@drawable/ic_music_note"
                    app:tint="@android:color/white" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/libre_music"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="מוזיקה בסטרימינג"
                        android:textColor="#99FFFFFF"
                        android:textSize="11sp" />

                </LinearLayout>

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:rotation="180"
                    app:tint="#40FFFFFF" />

            </LinearLayout>

            <!-- Category Games -->
            <LinearLayout
                android:id="@+id/category_games"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="8dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/category_games_icon"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_glass_card"
                    android:padding="8dp"
                    android:src="@drawable/ic_gamepad"
                    app:tint="@android:color/white" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/category_games"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ערוצי גיימינג"
                        android:textColor="#99FFFFFF"
                        android:textSize="11sp" />

                </LinearLayout>

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:rotation="180"
                    app:tint="#40FFFFFF" />

            </LinearLayout>

            <!-- Category News -->
            <LinearLayout
                android:id="@+id/category_news"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="8dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/category_news_icon"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_glass_card"
                    android:padding="8dp"
                    android:src="@drawable/ic_newspaper"
                    app:tint="@android:color/white" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/category_news"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="עדכונים שוטפים"
                        android:textColor="#99FFFFFF"
                        android:textSize="11sp" />

                </LinearLayout>

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:rotation="180"
                    app:tint="#40FFFFFF" />

            </LinearLayout>

            <!-- Category Sports -->
            <LinearLayout
                android:id="@+id/category_sports"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="8dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/category_sports_icon"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_glass_card"
                    android:padding="8dp"
                    android:src="@drawable/ic_trophy"
                    app:tint="@android:color/white" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/category_sports"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="שידורים וסיקור"
                        android:textColor="#99FFFFFF"
                        android:textSize="11sp" />

                </LinearLayout>

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:rotation="180"
                    app:tint="#40FFFFFF" />

            </LinearLayout>

            <!-- Category Podcasts -->
            <LinearLayout
                android:id="@+id/category_podcasts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="8dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/category_podcasts_icon"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_glass_card"
                    android:padding="8dp"
                    android:src="@drawable/ic_podcast"
                    app:tint="@android:color/white" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/category_podcasts"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="תכניות ורדיו"
                        android:textColor="#99FFFFFF"
                        android:textSize="11sp" />

                </LinearLayout>

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:rotation="180"
                    app:tint="#40FFFFFF" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="#1AFFFFFF" />

            <!-- General Section Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginBottom="6dp"
                android:text="כללי"
                android:textColor="#80FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Privacy Settings Button -->
            <LinearLayout
                android:id="@+id/category_settings_privacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_glass_card"
                    android:padding="8dp"
                    android:src="@drawable/ic_locked"
                    app:tint="@android:color/white" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="הגדרות פרטיות"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="בקרת הרשאות"
                        android:textColor="#80FFFFFF"
                        android:textSize="10sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- App Settings Button -->
            <LinearLayout
                android:id="@+id/category_settings_app"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_glass_card"
                    android:padding="8dp"
                    android:src="@drawable/ic_settings"
                    app:tint="@android:color/white" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="הגדרות אפליקציה"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="תצוגה, שמע, שפה"
                        android:textColor="#80FFFFFF"
                        android:textSize="10sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- About Button -->
            <LinearLayout
                android:id="@+id/category_settings_about"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_glass_card"
                    android:padding="8dp"
                    android:src="@drawable/ic_info"
                    app:tint="@android:color/white" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="אודות LibreKosher"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="רישיון MIT · קוד פתוח"
                        android:textColor="#80FFFFFF"
                        android:textSize="10sp" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Privacy Tip Footer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="#80102B30"
                android:gravity="center_vertical"
                android:padding="10dp"
                android:orientation="horizontal">

                <!-- Green dot -->
                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_home_icon_circle"
                    android:backgroundTint="#34d399" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="פרטיות מלאה — ללא מעקב, ללא Google"
                    android:textColor="#D834D399"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <LinearLayout
        android:id="@+id/nothing_here"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/listIV"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"
            android:src="@drawable/ic_list" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/emptyList"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/refresh_button"
            style="@style/Widget.Material3Expressive.Button"
            android:layout_width="150dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:text="@string/retry" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/change_instance"
            style="@style/Widget.Material3Expressive.Button"
            android:layout_width="150dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:layout_marginTop="5dp"
            android:text="@string/change_instance" />
    </LinearLayout>

    <com.google.android.material.loadingindicator.LoadingIndicator
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        tools:visibility="gone" />

</FrameLayout>
