<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="BaseTheme" parent="Theme.Material3Expressive.Dark.NoActionBar">

        <item name="android:windowBackground">@color/kosher_background</item>
        <item name="android:colorBackground">@color/kosher_background</item>
        <item name="colorSurface">@color/kosher_background</item>
        <item name="colorSurfaceContainer">@color/kosher_background</item>
        <item name="colorSurfaceContainerLow">@color/kosher_background</item>
        <item name="colorPrimary">@color/kosher_primary</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">@color/kosher_chip_active_bg</item>
        <item name="colorOnPrimaryContainer">#FFFFFF</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar" tools:ignore="NewApi">false</item>

        <item name="switchPreferenceCompatStyle">
            @style/Preference.SwitchPreferenceCompat.Material3
        </item>

        <item name="snackbarStyle">@style/snackBarStyle</item>

        <item name="loadingIndicatorStyle">@style/Widget.Material3.LoadingIndicator.Contained</item>

        <item name="materialAlertDialogTheme">@style/AlertDialogTheme</item>
    </style>

    <style name="SplashScreenTheme" parent="Theme.SplashScreen">

        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/BaseTheme</item>

    </style>

